{
  "ConnectionStrings": {
    "Identity": "Data Source=../../../data/identity.db",
    "Inventory": "Data Source=../../../data/inventory.db",
    "Cart": "Data Source=../../../data/cart.db",
    "Ordering": "Data Source=../../../data/ordering.db",
    "Payments": "Data Source=../../../data/payments.db",
    "Wishlist": "Data Source=../../../data/wishlist.db"
  },
  "Stripe": {
    "Enabled": false,
    "SecretKey": "",
    "WebhookSecret": ""
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false,connectTimeout=500,syncTimeout=500",
    "InstanceName": "ECommerce:"
  },
  "CatalogCache": {
    "ProductExpirationMinutes": 10,
    "SearchExpirationMinutes": 2,
    "CategoryExpirationMinutes": 2
  },
  "ReviewsMongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "ECommerceReviews",
    "ReviewsCollectionName": "reviews"
  },
  "ReviewsCache": {
    "ApprovedReviewsExpirationMinutes": 5
  },
  "WishlistCache": {
    "ExpirationMinutes": 10
  },
  "ShipmentTrackingCache": {
    "ExpirationMinutes": 5
  },
  "Inventory": {
    "LowStockThreshold": 10
  },
  "Identity": {
    "SeedAdmin": {
      "Enabled": false
    }
  },
  "Jwt": {
    "Key": "configure-a-development-secret-through-user-secrets",
    "Issuer": "ECommerce",
    "Audience": "ECommerce",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} CorrelationId={CorrelationId} TraceId={TraceId} SpanId={SpanId} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "OpenTelemetry": {
    "ServiceName": "ECommerce.Api",
    "ConsoleExporterEnabled": false,
    "OtlpExporterEnabled": false,
    "OtlpEndpoint": ""
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "PublicRead": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Authenticated": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Admin": {
      "PermitLimit": 180,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Api": {
    "MaxRequestBodyBytes": 1048576
  },
  "OpenApi": {
    "Title": "ECommerce API",
    "Description": "Modular monolith ecommerce backend API.",
    "Version": "v1",
    "Enabled": true,
    "EnableSwaggerUi": true
  },
  "AllowedHosts": "*"
}
